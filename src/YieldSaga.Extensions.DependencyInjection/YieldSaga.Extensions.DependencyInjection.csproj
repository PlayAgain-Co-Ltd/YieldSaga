<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>YieldSaga.Extensions.DependencyInjection</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>YieldSaga.Extensions.DependencyInjection</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>PlayAgain Co., Ltd.</Authors>
    <Company>PlayAgain Co., Ltd.</Company>
    <Description>Microsoft.Extensions.DependencyInjection integration for YieldSaga. Adds AddYieldSagaRuntime&lt;TState&gt;(builder) so Saga / Applier / Interceptor / Producer / EffectHandler / Bridge can be wired through the DI container.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PlayAgain-Co-Ltd/YieldSaga</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/PlayAgain-Co-Ltd/YieldSaga</PackageProjectUrl>
    <PackageTags>saga;effects;dependency-injection;microsoft-extensions-dependencyinjection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YieldSaga\YieldSaga.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YieldSaga.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
